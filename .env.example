# Copy to .env and fill in. docker compose reads .env automatically.

# Required. Any long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me

# Optional for local use; email/password login works without them.
# For Google login, add http://localhost:8080/api/auth/google/callback
# as an authorized redirect URI in the Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where users land after Google login
FRONTEND_URL=http://localhost:8080

# Host folder shared between workers and sandbox containers.
# Create it before the first `up`: mkdir -p /tmp/codeleet-jobs
CODE_TMP_DIR=/tmp/codeleet-jobs

# Group that owns the Docker socket: 0 on Docker Desktop (Mac/Windows).
# On Linux: stat -c %g /var/run/docker.sock
DOCKER_GID=0
