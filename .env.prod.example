# Production settings for docker-compose.prod.yml.
# On the server: cp .env.prod.example .env, then fill in every value.

# ---------- domain & HTTPS ----------
# DNS for this domain must point at the server; ports 80 and 443 must be open.
DOMAIN=codeleet.me
FRONTEND_URL=https://codeleet.me

# ---------- secrets ----------
# openssl rand -hex 32
JWT_SECRET=
# MongoDB Atlas connection string; allow the server's IP in Atlas Network Access
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/codeleet
# Google Cloud console -> authorized redirect URI:
#   https://codeleet.me/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- images ----------
# Published by .github/workflows/publish.yml. TAG is "latest" or a 7-char
# commit SHA (pin a SHA to deploy or roll back to an exact version).
REGISTRY=ghcr.io/iujjwalrai
TAG=latest

# ---------- host ----------
# Shared between workers and sandbox containers: mkdir -p this first
CODE_TMP_DIR=/var/lib/codeleet/jobs
# Group that owns the Docker socket: stat -c %g /var/run/docker.sock
DOCKER_GID=

# ---------- scaling ----------
# Keep API_REPLICAS=1 until Phase 2 (nginx re-resolving replicas)
API_REPLICAS=1
SUBMISSION_WORKER_REPLICAS=2
RUN_WORKER_REPLICAS=1
