# Optional. Leave these unset to call the backend on the same site as the page:
# nginx forwards /api and /ws in Docker, and the Vite dev server proxies them
# to http://localhost:5000 in development.
#
# Set them only when the API is on a different domain (no trailing slash).
# VITE_API_BASE_URL=https://api.example.com

# Defaults to VITE_API_BASE_URL (or the page origin) with ws(s):// and /ws.
# VITE_API_BASE_URL_WS=wss://api.example.com/ws
