# TLS entry point for production (docker-compose.prod.yml).
# Caddy gets and renews a Let's Encrypt certificate for $DOMAIN automatically;
# the domain's DNS must point at this server and ports 80/443 must be open.
# With DOMAIN=localhost it uses its own local certificate instead (for testing).

{$DOMAIN} {
	encode zstd gzip
	# Caddy sets X-Forwarded-Proto/For/Host; the gateway passes them on.
	reverse_proxy gateway:80
}
